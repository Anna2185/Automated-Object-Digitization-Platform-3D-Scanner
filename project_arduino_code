/* PINS SET UP
Stepper Motor (ULN2003 Driver): 
  VCC to + (battery 2)  
  GND to - (battery 2)
  IN1 IN2 IN3 IN4 to D8 D9 D10 D11 respectively

VL53L1X Sensor: 
  VCC to 5V (Arduino) 
  GND to GND (Arduino)
  SDA to SDA (Arduino I2C Bus)
  SCL to SCL (Arduino I2C Bus)
  GPI01 to D2
  XSHUT to 3.3V 

Servo Motor: 
  VCC to + (battery 1)
  GND to - (battery 1) & GND (Arduino)
  Signal to D6
*/


/* STEPPER MOTOR SETTINGS */

//standard for 28BYJ-48 Stepper
