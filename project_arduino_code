#include <Wire.h>
#include <VL53L1X.h>
#include <Stepper.h>
#include <Servo.h>

/* PINS SET UP
Stepper Motor (ULN2003 Driver): 
  VCC -> + (battery 2)  
  GND -> - (battery 2)
  IN1 IN2 IN3 IN4 -> D8 D9 D10 D11 

VL53L1X Sensor: 
  VCC -> 5V (Arduino) 
  GND -> GND (Arduino)
  SDA -> SDA (Arduino I2C Bus)
  SCL -> SCL (Arduino I2C Bus)
  GPI01 -> D2
  XSHUT -> 3.3V 

Servo Motor: 
  VCC -> + (battery 1)
  GND -> - (battery 1) & GND (Arduino)
  Signal -> D6
*/


/* STEPPER MOTOR SETTINGS */
//standard for 28BYJ-48 Stepper
const int stepsPerRevolution = 2048; 

//2048 steps/72 positions = ~28 steps per 5°
const int rotationSteps = 28; 

//75 vertical levels (2 mm increments = 15cm span)
const int totalHeightLevels = 75;   

//Servo Settings
//bottom/start angle
const int servoStartPos = 180;
//amount to move upward each layer
const int servoStepPerLayer = 5;
//current servo position
int servoPosition = servoStartPos;


/* Pin Defitions/Objects */
Stepper turntable(stepsPerRevolution, 8, 9, 10, 11); //IN1 IN2 IN3 IN4 pattern
Servo linearAxis;
VL53L1X distanceSensor;


void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(400000);

  ///Initialize Sensor
  distanceSensor.setTimeout(500);

  if (!distanceSensor.init()) {
    Serial.println("SENSOR FAILED");
    while (1);
  }
  Serial.println("Sensor working");

  distanceSensor.setDistanceMode(VL53L1X::Short); //set the short distance setting, accurate under 1.3m
  distanceSensor.setMeasurementTimingBudget(20000); //20ms max per reading
  distanceSensor.startContinuous(20);

  ///Set-up Motors
  turntable.setSpeed(12); //high speed for stepper

  linearAxis.attach(6);
  delay(500);
  // move to known starting position
  servoPosition = servoStartPos;
  linearAxis.write(servoPosition);
  Serial.println("Vertical axis back to original position");
  delay(1000);

  Serial.println("System Ready. Starting Scan in 3 Seconds:  ");
  delay(3000);
}

void loop() {
  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd == "SCAN") {

      scan();
    }
  }
}

void scan(){
  //Height Levels Loop
  for (int level = 0; level < totalHeightLevels; level++){
    delay(300);
    Serial.print("Scanning at level:");
    Serial.println(level);

    //Stepper Rotation Loop
    for (int angleCount = 0; angleCount < 72; angleCount++){
      int currentAngle = angleCount*5; //mult by 5 since its per 5 deg angles

      //read sensor
      uint16_t readingMm = distanceSensor.read();

      //skip invalid readings
      if (distanceSensor.timeoutOccurred()) {
        Serial.println("TIMEOUT");
        continue;
      }

      //output the raw coordinates 
      //"level angle distance" format
      Serial.print(level);
      Serial.print(",");
      Serial.print(currentAngle);
      Serial.print(",");
      Serial.println(readingMm);

      //Rotate Stepper
      turntable.step(rotationSteps);

      delay(50); //might want to change it to 50 eventually
    }

    //Move sensor up (using servo)
    if (level < (totalHeightLevels -1)) {
      Serial.println("moving up");

      //move upward one level
      servoPosition -= servoStepPerLayer;

      //limit range
      servoPosition = constrain(servoPosition, 0, 180);

      linearAxis.write(servoPosition);

      delay(500);
    }
  }
  Serial.println("Scan Complete");

  //Return to start
  Serial.println("Returning to bottom");

  // return to start position
  servoPosition = servoStartPos;
  linearAxis.write(servoPosition);
  delay(1000);
}
