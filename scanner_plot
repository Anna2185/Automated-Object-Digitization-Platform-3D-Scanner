import serial
import time
import serial.tools.list_ports
import numpy as np
import matplotlib.pyplot as plt
import trimesh

def find_port():
    ports = serial.tools.list_ports.comports()
    for p in ports:
        print("Using:", p.device)
        return p.device
    return None

port = find_port()
if not port:
    print("No Arduino found")
    exit()

ser = serial.Serial(port, 115200, timeout=1)
time.sleep(2)

print("Connected")
ser.write(b"SCAN\n")

points = []

print("Waiting for data...\n")

# ---- CONFIG ----
TOTAL_LAYERS = 75
Z_STEP_MM = 2.0   # adjust if each layer is ~2mm physically

while True:
    line = ser.readline().decode(errors='ignore').strip()

    if not line:
        continue

    print(line)

    if "scan complete" in line.lower():
        break

    if "," not in line:
        continue

    try:
        level, angle, distance = map(float, line.split(","))

        angle_rad = np.radians(angle)

        SCANNER_RADIUS = 120  # mm
        r = SCANNER_RADIUS - distance

        x = r * np.cos(angle_rad)
        y = r * np.sin(angle_rad)

        #FIXED Z SCALING FOR 75 LAYERS
        z = level * Z_STEP_MM

        points.append([x, y, z])

    except:
        pass

if len(points) == 0:
    print("No scan points received")
    exit()

points = np.array(points)

# ---- PLOT ----
fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')

ax.scatter(points[:, 0], points[:, 1], points[:, 2], s=2)

ax.set_xlabel("X")
ax.set_ylabel("Y")
ax.set_zlabel("Z")

plt.show()

# ---- STL ----
print("Generating STL...")

mesh = trimesh.points.PointCloud(points).convex_hull
mesh.export("scan_output.stl")

print("STL saved as scan_output.stl")


































import serial
import time
import serial.tools.list_ports
import numpy as np
import matplotlib.pyplot as plt
import trimesh

"Detect the port automatically"
def find_port():
    ports = serial.tools.list_ports.comports()

    for p in ports:
        print("Using:", p.device)
        return p.device
    return None


port = find_port()
if not port:
    print("No Arduino found")
    exit()

#Connect to port
ser = serial.Serial(port, 115200, timeout=1)
time.sleep(2)
print("Connected")
ser.write(b"SCAN\n")

#Store the points
points = []
print("Waiting for data...\n")


"Read Serial"
while True:
    line = ser.readline().decode(errors='ignore').strip()

    if not line:
        continue
    print(line)

    #stop condition
    if "Scan Complete" in line:
        break

    #skip text lines
    if "," not in line:
        continue

    try:
        #Arduino sends: level,angle,distance
        level, angle, distance = map(float, line.split(","))

        #convert angle to radians
        angle_rad = np.radians(angle)

        #polar -> Cartesian
        x = distance * np.cos(angle_rad)
        y = distance * np.sin(angle_rad)
        z = level * 10   # convert cm -> mm

        points.append([x, y, z])

    except:
        pass


#check
if len(points) == 0:
    print("No scan points received")
    exit()


#numpy
points = np.array(points)

" Plot the data "
fig = plt.figure()

ax = fig.add_subplot(111, projection='3d')

ax.scatter(
    points[:, 0],
    points[:, 1],
    points[:, 2],
    s=2
)

ax.set_xlabel("X")
ax.set_ylabel("Y")
ax.set_zlabel("Z")

plt.show()


#generate the STL file
print("Generating STL...")

#point cloud -> mesh
mesh = trimesh.points.PointCloud(points).convex_hull

#export STL file
mesh.export("scan_output.stl")
print("STL saved as scan_output.stl")
